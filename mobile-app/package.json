{
  "name": "clinton-pos-mobile",
  "version": "1.0.0",
  "description": "Clinton POS Mobile - Handheld/Speedpoint Application for Cashiers & Waiters",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npx expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "dev": "npx expo start --tunnel",
    "build:android": "eas build --platform android",
    "build:apk": "eas build --platform android --profile preview",
    "build:local": "eas build --platform android --profile preview --local",
    "prebuild": "npx expo prebuild",
    "export": "npx expo export"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "expo": "~51.0.0",
    "expo-barcode-scanner": "~13.0.0",
    "expo-camera": "~15.0.0",
    "expo-constants": "~16.0.0",
    "expo-device": "~6.0.0",
    "expo-haptics": "~13.0.0",
    "expo-network": "~6.0.0",
    "expo-print": "~13.0.0",
    "expo-secure-store": "~13.0.0",
    "expo-splash-screen": "~0.27.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "react-native-toast-message": "^2.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.45",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.0"
  },
  "private": true
}
