# Turso DB — required for the Hono edge function
# Get these from: https://turso.tech/app/databases
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
BARCODENEST_API_KEY=your-barcodenest-api-key

# JWT signing secret (min 32 chars, change in production)
JWT_SECRET=change-me-in-production-minimum-32-chars-please

# Password hashing pepper (change in production)
PASSWORD_PEPPER=change-this-pepper-in-production

# Cloudflare R2 — create an S3 API token scoped to the onboarding bucket
R2_ACCOUNT_ID=23bcf23037270f5e8d4eec35ec7ee46f
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=cpos-onboarding-documents

# Transactional email delivery for onboarding notifications (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@your-verified-domain.com

# Supabase edge function runtime vars (still needed if hosting the function on Supabase)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are NO LONGER needed
# (the data layer now uses Turso — Supabase is only used as the edge function host)
