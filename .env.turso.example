# Turso DB — required for the Hono edge function
# Get these from: https://turso.tech/app/databases
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT signing secret (min 32 chars, change in production)
JWT_SECRET=change-me-in-production-minimum-32-chars-please

# Password hashing pepper (change in production)
PASSWORD_PEPPER=change-this-pepper-in-production

# Supabase edge function runtime vars (still needed if hosting the function on Supabase)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are NO LONGER needed
# (the data layer now uses Turso — Supabase is only used as the edge function host)
