# Queue worker config — copy to `.env.worker` and fill in.
# (`pnpm queue:worker` loads `.env.worker` automatically. Never commit the real one.)

# Edge function base URL (no trailing slash).
# Cloud:  https://tktryrmospxbbuylweui.supabase.co/functions/v1/make-server-69ad2d15
# Local:  http://localhost:8000/make-server-69ad2d15  (deno run, see docs/queue-cache.md)
WORKER_API_BASE=https://tktryrmospxbbuylweui.supabase.co/functions/v1/make-server-69ad2d15

# Shared secret. MUST match the server's WORKER_SECRET (supabase secrets set),
# otherwise the worker gets 403 on every call.
WORKER_SECRET=change-me-to-a-long-random-value

# RabbitMQ Management HTTP API base (no trailing slash) — the MANAGEMENT port,
# never the AMQP port. Local compose defaults to 15672; use 15673 if something
# else on this machine already owns 15672 (e.g. another dev broker).
# `pnpm queue:worker` will start the compose broker on whatever port you set here.
RABBITMQ_URL=http://localhost:15673

# Broker credentials (must match RABBITMQ_DEFAULT_USER/_PASS in compose).
RABBITMQ_USER=cpos
RABBITMQ_PASSWORD=cpos-dev-secret

# Optional (defaults shown):
# RABBITMQ_VHOST=/
# RABBITMQ_QUEUE=cpos.jobs
# WORKER_POLL_MS=5000
# WORKER_MAX_BATCHES=40
